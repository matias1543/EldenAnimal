  m_Script: {fileID: 11500000, guid: f3c29cab06e61fa4b91c62310c2ecedf, type: 3}
  m_Name: Tito_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _speakerName: Tito
  _lines:
  - Hola... soy Tito, el alquimista de la isla.
  - Unas aves salvajes y un monstruo tomaron mi laboratorio en la meseta del oeste.
  - "Si los ech\xE1s, te doy dos pociones grandes y te curo por completo."
