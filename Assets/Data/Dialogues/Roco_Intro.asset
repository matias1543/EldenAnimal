  m_Script: {fileID: 11500000, guid: f3c29cab06e61fa4b91c62310c2ecedf, type: 3}
  m_Name: Roco_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _speakerName: Roco
  _lines:
  - "\xA1Hola! Soy Roco, el minero. Esta cueva lleva al bosque del oeste."
  - "Ah\xED perd\xED mi Perla del Oeste cuando me atacaron unos monstruos embestidores."
  - "Si me la tra\xE9s, te refuerzo el escudo: vas a bloquear casi todo el da\xF1o
    y cansarte mucho menos."
