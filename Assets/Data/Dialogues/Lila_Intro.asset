  m_Script: {fileID: 11500000, guid: f3c29cab06e61fa4b91c62310c2ecedf, type: 3}
  m_Name: Lila_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _speakerName: Lila
  _lines:
  - "\xA1Ey! Soy Lila, cazadora de esta isla."
  - "Unos monstruos embestidores invadieron el bosque del suroeste. \xA1Te persiguen
    y te embisten a toda velocidad!"
  - "Si los elimin\xE1s a todos, te afilo el arma: vas a pegar un 50% m\xE1s fuerte.
    Contra el Rey Slime te va a venir b\xE1rbaro."
